{
    "$comment": "Open-source asset packs mirrored into editor/public/library by scripts/mirror-library.mjs, so the editor can offer them without depending on the upstream links. Only CC0 or public domain assets: the mirror ships them with the editor. ref pins the upstream commit; run the script with --latest to move to the newest one.",
    "sources": [
        {
            "id": "kenney-city",
            "name": "Starter Kit City Builder",
            "author": "Kenney",
            "license": "CC0-1.0",
            "licenseNote": "Its README marks the sprites and 3D models CC0 (the project code is MIT); its sounds are left out.",
            "url": "https://github.com/KenneyNL/Starter-Kit-City-Builder",
            "git": "https://github.com/KenneyNL/Starter-Kit-City-Builder",
            "ref": "4535092b740b378b700efd9df9e27a631815b84a",
            "items": [
                { "glob": "models/building-*.glb", "kind": "model", "tags": ["city", "building"] },
                { "glob": "models/road-*.glb", "kind": "model", "tags": ["city", "road"] },
                { "glob": "models/pavement*.glb", "kind": "model", "tags": ["city", "ground"] },
                { "glob": "models/grass*.glb", "kind": "model", "tags": ["city", "nature", "ground"] }
            ]
        },
        {
            "id": "kenney-arena",
            "name": "Mini Arena",
            "author": "Kenney",
            "license": "CC0-1.0",
            "url": "https://github.com/KenneyNL/Starter-Kit-Basic-Scene",
            "git": "https://github.com/KenneyNL/Starter-Kit-Basic-Scene",
            "ref": "a6927e66ff8dd8e173660ce4825abe773c65f683",
            "items": [
                { "glob": "sample/Mini Arena/Models/GLB format/*.glb", "kind": "model", "tags": ["arena", "medieval"] }
            ]
        },
        {
            "id": "kenney-platformer",
            "name": "Starter Kit 3D Platformer",
            "author": "Kenney",
            "license": "CC0-1.0",
            "url": "https://github.com/KenneyNL/Starter-Kit-3D-Platformer",
            "git": "https://github.com/KenneyNL/Starter-Kit-3D-Platformer",
            "ref": "3fa8a04b1c01ab23db43123d4ce814a34c3fc7f0",
            "items": [
                { "glob": "models/*.glb", "kind": "model", "tags": ["platformer"] },
                { "glob": "sounds/*.ogg", "kind": "audio", "tags": ["platformer", "effect"] },
                { "glob": "sprites/particle.png", "kind": "texture", "tags": ["particle"] }
            ]
        },
        {
            "id": "kenney-fps",
            "name": "Starter Kit FPS",
            "author": "Kenney",
            "license": "CC0-1.0",
            "url": "https://github.com/KenneyNL/Starter-Kit-FPS",
            "git": "https://github.com/KenneyNL/Starter-Kit-FPS",
            "ref": "185fd2326d74a5cf858cffc616f87cf9696f9cc0",
            "items": [
                { "glob": "models/*.glb", "kind": "model", "tags": ["shooter"] },
                { "glob": "sounds/*.ogg", "kind": "audio", "tags": ["shooter", "effect"] },
                { "glob": "sprites/blob_shadow.png", "kind": "texture", "tags": ["decal"] },
                { "glob": "sprites/burst.png", "kind": "texture", "tags": ["particle"] }
            ]
        },
        {
            "id": "kenney-racing",
            "name": "Starter Kit Racing",
            "author": "Kenney",
            "license": "CC0-1.0",
            "url": "https://github.com/KenneyNL/Starter-Kit-Racing",
            "git": "https://github.com/KenneyNL/Starter-Kit-Racing",
            "ref": "2f2e5f2646dda89cb21d4e8539bab60c6e955dc8",
            "items": [
                { "glob": "models/*.glb", "kind": "model", "tags": ["racing"] },
                { "glob": "audio/*.ogg", "kind": "audio", "tags": ["racing", "effect"] },
                { "glob": "sprites/smoke.png", "kind": "texture", "tags": ["particle"] }
            ]
        }
    ]
}
