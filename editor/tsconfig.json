{
    "compilerOptions": {
        "target": "ESNext",
        "useDefineForClassFields": true,
        "module": "ESNext",
        "lib": ["ESNext", "DOM", "DOM.Iterable"],
        "moduleResolution": "bundler",
        "resolveJsonModule": true,
        "esModuleInterop": true,
        "noEmit": true,
        "skipLibCheck": true,
        "allowJs": true,
        "strict": false,
        "experimentalDecorators": true,
        "baseUrl": "./",
        "paths": {
            "@orillusion/core": ["../src/index.ts"],
            "@orillusion/particle": ["../packages/particle/index.ts"]
        },
        "types": ["vite/client", "@webgpu/types"]
    },
    "include": ["src"]
}
