{
    // The engine (../src) and the particle package, which the editor imports as
    // source. As a referenced project the editor type checks against their
    // declarations, so the editor can be strict while the engine is not.
    // `tsc -b` writes the declarations to node_modules/.cache/engine-types.
    "compilerOptions": {
        "composite": true,
        "emitDeclarationOnly": true,
        "declaration": true,
        "rootDir": "..",
        "outDir": "../node_modules/.cache/engine-types",
        "tsBuildInfoFile": "../node_modules/.cache/engine-types/engine.tsbuildinfo",
        "target": "ESNext",
        "useDefineForClassFields": true,
        "module": "ESNext",
        "lib": ["ESNext", "DOM", "DOM.Iterable"],
        "moduleResolution": "bundler",
        "resolveJsonModule": true,
        "esModuleInterop": true,
        "skipLibCheck": true,
        "strict": false,
        "experimentalDecorators": true,
        "baseUrl": ".",
        "paths": {
            "@orillusion/core": ["../src/index.ts"]
        },
        "types": ["vite/client", "@webgpu/types"]
    },
    "include": ["../src", "../packages/particle", "../package.json"],
    "exclude": ["../packages/particle/vite.config.js"]
}
